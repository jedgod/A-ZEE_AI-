PORT=3001
DATABASE_URL=postgres://aztrade_app:CHANGE_ME_NOT_A_REAL_PASSWORD@localhost:5432/aztrade
# stub = development only (forbidden when NODE_ENV=production)
# jwt  = require A-Zee bearer token (verifier must be implemented)
AUTH_MODE=stub
NODE_ENV=development
# Comma-separated allowlist. Do not use * in production.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Set true to refuse orders when quote age > 15 minutes
ENFORCE_QUOTE_FRESHNESS=true

# Required for production. Exact values must come from the A-Zee identity authority.
AZEE_JWT_ISSUER=
AZEE_JWT_AUDIENCE=
AZEE_JWKS_URL=
AZEE_INTROSPECTION_URL=
AZEE_INTROSPECTION_TOKEN=

# mTLS for the A-Zee introspection call (REQUIRED in production; identity.js fails closed without it).
# Paths only - never put key material in this file. Files come from the secret store/mount for the environment.
AZEE_INTROSPECTION_MTLS_CERT_FILE=
AZEE_INTROSPECTION_MTLS_KEY_FILE=
AZEE_INTROSPECTION_MTLS_CA_FILE=
AZEE_INTROSPECTION_MTLS_SERVER_NAME=
