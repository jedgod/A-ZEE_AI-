{
  "name": "az-ai-admin-runtime",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "dev": "next dev --hostname localhost",
    "build": "node --require ./scripts/windows-fs-compat.cjs node_modules/next/dist/bin/next build",
    "start": "next start --hostname localhost",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.cjs",
    "connect:token": "node scripts/connect-token.cjs",
    "azee": "node azee-connect/cli/azee.mjs",
    "test:py": "python -m unittest discover -s 02_PREPROCESS/tests && python -m unittest discover -s 03_CONTEXT/tests",
    "staff:create": "node scripts/staff-create.cjs",
    "account:seed": "node scripts/account-seed.cjs",
    "check:operations": "node scripts/check-operations.cjs",
    "plan:set": "node scripts/plan-set.cjs",
    "check:sidebar": "node scripts/check-sidebar.cjs",
    "check:search": "node scripts/check-search.cjs",
    "check:connectors": "node scripts/check-connectors.cjs",
    "check:code-agent": "node scripts/check-code-agent.cjs",
    "check:billing": "node scripts/check-billing.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next": "^15.5.28",
    "openai": "^7.47.0",
    "pg": "^8.15.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.23",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
