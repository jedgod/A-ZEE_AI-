{
  "name": "aztrade-api",
  "version": "1.0.0",
  "description": "AZTrade AI \u2014 Production financial engine API (PostgreSQL)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:schema": "psql $DATABASE_URL -f sql/schema.sql",
    "db:seed": "psql $DATABASE_URL -f sql/seed.sql",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "jose": "^5.9.6"
  },
  "engines": {
    "node": ">=18"
  }
}
