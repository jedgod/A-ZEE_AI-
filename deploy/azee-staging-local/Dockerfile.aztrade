# AZTrade API (paper trading). Build context: the AZTrade repository (see AZTRADE_REPO in compose.yaml).
# with-secrets.sh is supplied as an additional named build context (see compose.yaml: additional_contexts).
FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /srv
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY backend/ ./
COPY --from=tools with-secrets.sh /usr/local/bin/with-secrets
RUN chmod +x /usr/local/bin/with-secrets
USER node
EXPOSE 3001
ENTRYPOINT ["/usr/local/bin/with-secrets"]
CMD ["node", "server.js"]
