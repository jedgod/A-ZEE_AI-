# TEMPLATE for /etc/azee/ollama-health.env (names and non-secret values only).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Record the ACTUAL digest after the model is installed (ollama list / GET /api/tags). Never guess it.
OLLAMA_MODEL_DIGEST=
TUNNEL_CHECK_INTERVAL_MS=30000
TUNNEL_STATUS_FILE=/var/lib/azee/health/ollama-status.json
TUNNEL_ALERT_FILE=/var/lib/azee/health/ollama-alerts.jsonl
ALERT_OWNER=azee-staging-owner
ALERT_RUNBOOK=docs/oracle-staging-ai-topology.md
# Enable email once Oracle Email Delivery is configured and approved (see deploy/oracle/alerts.env.example):
# ALERT_COMMAND=node /opt/azee/scripts/staging/alert-smtp.mjs
