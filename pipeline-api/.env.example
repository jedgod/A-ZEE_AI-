# Replace all local secrets. URL-encode the database password if it contains URL-reserved characters.
POSTGRES_PASSWORD=replace-with-a-long-local-password
DATABASE_URL=postgresql+asyncpg://pipeline:replace-with-a-long-local-password@db:5432/pipeline
API_TOKEN=replace-with-a-random-32-byte-token
TENANT_ID=local

# Used for moderation (and, by default, embeddings and chat).
OPENAI_API_KEY=replace-with-your-provider-key

# Optional: any OpenAI-compatible endpoint for embeddings / LangChain chat. Example (Gemini):
# EMBEDDING_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_API_KEY=your-gemini-key
# EMBEDDING_MODEL=gemini-embedding-001
# CHAT_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# CHAT_API_KEY=your-gemini-key
# CHAT_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o-mini

# Set only to enable web retrieval.
BRAVE_API_KEY=
CONTEXT_TOKENS=4000
# en_core_web_lg (default, installed by the Dockerfile) or en_core_web_sm for light local setups.
SPACY_MODEL=en_core_web_lg
