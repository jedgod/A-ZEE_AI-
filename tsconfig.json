{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "00_META/**/*.ts",
    "01_INTAKE/**/schema.ts",
    "04_ROUTING/**/*.ts",
    "05_MODEL_LAYER/**/*.ts",
    "06_PROMPT_ENGINE/**/*.ts",
    "07_TOOLS/**/*.ts",
    "08_REASONING/**/*.ts",
    "09_GENERATION/**/*.ts",
    "10_VALIDATION/**/*.ts",
    "11_POSTPROCESS/**/*.ts",
    "12_DELIVERY/**/*.ts",
    "13_FEEDBACK/**/*.ts",
    "14_OBSERVABILITY/**/*.ts",
    "15_EXTENSIONS/**/*.ts",
    "*_*/*/page.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
