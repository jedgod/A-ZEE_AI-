<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application>
    <!-- The AZLinqext keyboard. Android shows it in Settings > Languages & input > On-screen keyboard. -->
    <service
      android:name="expo.modules.azlinqext.ime.AzKeyboardService"
      android:label="@string/azlinqext_ime_label"
      android:permission="android.permission.BIND_INPUT_METHOD"
      android:exported="true">
      <intent-filter>
        <action android:name="android.view.InputMethod" />
      </intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/azlinqext_method" />
    </service>

    <!-- Autopilot: reads message notifications from chat apps only after the user turns on notification access and picks a mode. -->
    <service
      android:name="expo.modules.azlinqext.autopilot.AzNotificationListener"
      android:label="@string/azlinqext_ime_label"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
    <receiver android:name="expo.modules.azlinqext.autopilot.AutopilotReceiver" android:exported="false" />
  </application>
</manifest>
