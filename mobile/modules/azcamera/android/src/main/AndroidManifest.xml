<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets the app see that a camera app exists (Android 11+). No CAMERA permission is needed: the phone's own camera app takes the picture. -->
  <queries>
    <intent>
      <action android:name="android.media.action.IMAGE_CAPTURE" />
    </intent>
  </queries>
  <application>
    <!-- "A-Zee Image Verify" in the Android share sheet: share a picture from WhatsApp, Telegram, Gallery or any app to check it. -->
    <activity-alias
      android:name="expo.modules.azcamera.ImageVerifyShare"
      android:targetActivity="${applicationId}.MainActivity"
      android:label="A-Zee Image Verify"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="image/*" />
      </intent-filter>
    </activity-alias>
    <!-- Gives the camera app a private place in this app's private storage to write one photo. Nothing else is shared. -->
    <provider
      android:name="expo.modules.azcamera.AzCameraFileProvider"
      android:authorities="${applicationId}.azcamera.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/azcamera_paths" />
    </provider>
  </application>
</manifest>
